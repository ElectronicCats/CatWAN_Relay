      "parameters": {
        "jsCode": "const input = $input.item.json;\n\n// 1. Procesar la Fecha Actual\nconst fechaReloj = new Date();\nconst opcionesFecha = { \n  weekday: 'long', \n  year: 'numeric', \n  month: 'long', \n  day: 'numeric' \n};\n// Resultado ej: \"lunes, 19 de enero de 2026\"\nconst fechaFormateada = fechaReloj.toLocaleDateString('es-ES', opcionesFecha);\n\n// 2. Función para convertir HH:MM:SS a formato 12h (am/pm)\nfunction formatarAMPM(horaString) {\n  if (!horaString) return \"00:00 am\";\n  \n  let [horas, minutos, segundos] = horaString.split(':');\n  horas = parseInt(horas);\n  \n  const ampm = horas >= 12 ? 'pm' : 'am';\n  horas = horas % 12;\n  horas = horas ? horas : 12; // La hora '0' debe ser '12'\n  \n  return `${horas.toString().padStart(2, '0')}:${minutos} ${ampm}`;\n}\n\nconst horaAmPm = formatarAMPM(input.ts);\n\nreturn {\n  fecha_completa: fechaFormateada,\n  hora_encendido: horaAmPm,\n  timestamp_legible: `${fechaFormateada} a las ${horaAmPm}`,\n  dispositivo: $input.first().json.body.dev,\n  estado:$input.first().json.body.st ,\n  uid: $input.first().json.body.uid\n};"
      },
