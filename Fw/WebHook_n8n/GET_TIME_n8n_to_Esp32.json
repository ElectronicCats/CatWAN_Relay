{
  "name": "Time Sync API",
  "nodes": [
    {
      "parameters": {
        "path": "time",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook Time",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
